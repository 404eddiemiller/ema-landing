---
import archiveCopy from '../../../data/archive-copy.json';
// Blog article page (German) — Dynamic route for individual German blog posts
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import AgencyArticleCta from '../../../components/AgencyArticleCta.astro';
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(p => !p.data.draft && p.data.lang === 'de');
  const sorted = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return sorted.map((post, i) => ({
    params: { slug: post.data.slug },
    props: { post, displayDate: new Date(post.data.date) },
  }));
}

const { post, displayDate } = Astro.props;
const pendingEvidence = post.data.evidenceStatus === 'needs-review';
const archiveText = archiveCopy['de'];
const articleTitle = pendingEvidence ? archiveText[0] : post.data.title;
const articleDescription = pendingEvidence ? archiveText[1] : post.data.meta_description;
const Content = pendingEvidence ? null : (await render(post)).Content;
const canonicalUrl = `https://eddiemiller.agency/de/blog/${post.data.slug}`;
const wordCount = post.body ? post.body.replace(/[#*\[\]()>_`~\-|]/g, '').split(/\s+/).filter(Boolean).length : 0;
const articleImage = !pendingEvidence && post.data.image
  ? `https://eddiemiller.agency${post.data.image}`
  : 'https://eddiemiller.agency/social-card.png';

const formattedDate = displayDate.toLocaleDateString('de-DE', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Keep related reading in the same language and out of the review queue.
const relatedPosts = (await getCollection('blog'))
  .filter(p => p.data.lang === 'de' && !p.data.draft && p.data.evidenceStatus !== 'needs-review' && post.data.internal_links?.some(link => link.slug === p.data.slug))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Layout
  title={pendingEvidence ? archiveText[0] : post.data.meta_title}
  description={articleDescription}
  canonicalUrl={canonicalUrl}
  ogTitle={pendingEvidence ? archiveText[0] : post.data.meta_title}
  ogDescription={articleDescription}
  ogType={pendingEvidence ? 'website' : 'article'}
  ogImage={articleImage}
  skipFaqSchema={true}
  noindex={pendingEvidence}
>
  <Header />
  {pendingEvidence ? (
    <main id="main-content" class="max-w-[720px] mx-auto px-6 pt-32 pb-16">
      <h1 class="font-serif text-3xl mb-6">{articleTitle}</h1>
      <p>{articleDescription}</p>
      <a class="inline-block mt-6 underline" href="/de/blog">Blog</a>
    </main>
  ) : <>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": articleTitle,
    "description": articleDescription,
    "datePublished": post.data.date.toISOString().split('T')[0],
    "dateModified": post.data.date.toISOString().split('T')[0],
    "author": { "@type": "Organization", "name": "Eddie Miller Agency", "url": "https://eddiemiller.agency" },
    "publisher": { "@type": "Organization", "name": "Eddie Miller Agency", "url": "https://eddiemiller.agency", "logo": { "@type": "ImageObject", "url": "https://eddiemiller.agency/favicon.svg" } },
    "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
    "image": articleImage,
    "inLanguage": "de",
    "keywords": post.data.tags.join(", "),
    "articleSection": post.data.category,
    "wordCount": wordCount,
    "isAccessibleForFree": true
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://eddiemiller.agency/de" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://eddiemiller.agency/de/blog" },
      { "@type": "ListItem", "position": 3, "name": articleTitle, "item": canonicalUrl }
    ]
  })} />

  <article id="main-content" class="pt-28 md:pt-32 pb-16 md:pb-24">
    <div class="max-w-[720px] mx-auto px-6 md:px-8">

      <div class="mb-10 md:mb-14">
        <nav aria-label="Brotkruemelnavigation" class="mb-8 md:mb-10">
          <ol class="flex items-center gap-2 text-sm font-sans text-stone">
            <li><a href="/de" class="font-medium tracking-wide transition-colors duration-200 hover:text-terracotta">Startseite</a></li>
            <li aria-hidden="true" class="text-warmgray">/</li>
            <li><a href="/de/blog" class="font-medium tracking-wide transition-colors duration-200 hover:text-terracotta">Blog</a></li>
            <li aria-hidden="true" class="text-warmgray">/</li>
            <li class="text-warmgray truncate max-w-[200px] md:max-w-none" aria-current="page">{articleTitle}</li>
          </ol>
        </nav>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-sans text-stone mb-4">
          <span class="font-medium text-terracotta uppercase tracking-wider text-xs">{post.data.category}</span>
          <span class="text-warmgray" aria-hidden="true">&middot;</span>
          <time datetime={displayDate.toISOString().split('T')[0]}>{formattedDate}</time>
          <span class="text-warmgray" aria-hidden="true">&middot;</span>
          <span>{post.data.reading_time} Lesezeit</span>
        </div>

        <h1 class="font-serif text-3xl md:text-[2.75rem] lg:text-5xl text-charcoal leading-[1.15] tracking-tight">
          {articleTitle}
        </h1>
      </div>

      {post.data.image && (
        <div class="mb-10 md:mb-14 fade-in">
          <picture>
            <source srcset={post.data.image.replace('.webp', '.avif')} type="image/avif" />
            <source srcset={post.data.image} type="image/webp" />
            <img src={post.data.image} alt={post.data.imageAlt || post.data.title} width="1200" height="630" loading="eager" decoding="async" class="w-full h-auto" style="aspect-ratio: 1200/630; object-fit: cover;" />
          </picture>
        </div>
      )}

      <div class="prose">{post.data.evidenceStatus !== 'verified' && <p class="ema-archive-note">{archiveText[2]}</p>}{Content && <Content />}</div>

      <AgencyArticleCta />

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-10 pt-8 border-t border-warmgray/30">
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag: string) => (
              <span class="inline-block px-3 py-1 text-xs font-sans font-medium text-stone bg-sand tracking-wide uppercase">{tag}</span>
            ))}
          </div>
        </div>
      )}

      {relatedPosts.length > 0 && (
        <div class="mt-10 pt-8 border-t border-warmgray/30">
          <h2 class="font-serif text-xl md:text-2xl text-charcoal mb-6">Weitere Artikel</h2>
          <div class="space-y-4">
            {relatedPosts.map((related) => (
              <a href={`/de/blog/${related.data.slug}`} class="block group py-3 transition-colors duration-200">
                <span class="inline-block text-xs font-sans font-medium text-terracotta uppercase tracking-wider mb-1">{related.data.category}</span>
                <p class="font-serif text-lg text-charcoal group-hover:text-terracotta transition-colors duration-200 leading-snug">{related.data.title}</p>
              </a>
            ))}
          </div>
        </div>
      )}

    </div>
  </article>

  </>}
  <Footer />
</Layout>
