---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AgencyService from '../components/AgencyService.astro';
import { getAgency } from '../data/agency';
const c = getAgency();
---
<Layout title={c.services[1] + ' à Paris — Eddie Miller Agency'} description={c.description} skipFaqSchema>
  <Header /><main id="main-content"><AgencyService service={1} /></main><Footer />
</Layout>
