---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AgencyAbout from '../../components/AgencyAbout.astro';
import { getAgency } from '../../data/agency';
const c = getAgency('es');
---
<Layout title={c.aboutTitle.join(' ') + ' — Eddie Miller Agency'} description={c.description} ogTitle={c.aboutTitle.join(' ') + ' — Eddie Miller Agency'} ogDescription={c.description} skipFaqSchema>
  <Header /><main id="main-content"><AgencyAbout /></main><Footer />
</Layout>
