---
import { getLocaleFromPath, navRoutes } from '../i18n';
import { getAgency } from '../data/agency';
const locale = getLocaleFromPath(Astro.url.pathname);
const c = getAgency(locale);
const copy = {
 fr: ['Merci pour votre demande.', 'Nous reviendrons vers vous pour préciser votre besoin et convenir d’un premier échange.', 'Retour à l’accueil'],
 en: ['Thank you for your enquiry.', 'We will get back to you to understand your needs and arrange an initial conversation.', 'Back to home'],
 es: ['Gracias por tu consulta.', 'Te contactaremos para concretar tus necesidades y organizar una primera conversación.', 'Volver al inicio'],
 de: ['Vielen Dank für Ihre Anfrage.', 'Wir melden uns, um Ihren Bedarf zu besprechen und ein erstes Gespräch zu vereinbaren.', 'Zur Startseite'],
 it: ['Grazie per la tua richiesta.', 'Ti contatteremo per capire le tue esigenze e concordare un primo colloquio.', 'Torna alla home'],
 pt: ['Obrigado pelo seu pedido.', 'Entraremos em contacto para compreender as suas necessidades e combinar uma primeira conversa.', 'Voltar ao início'],
 nl: ['Bedankt voor uw aanvraag.', 'Wij nemen contact op om uw behoeften te bespreken en een eerste gesprek af te spreken.', 'Terug naar de startpagina'],
}[locale];
---
<section class="ema-wrap ema-page-hero"><p class="ema-eyebrow">EDDIE MILLER AGENCY</p><h1>{copy[0]}</h1><p class="ema-prose">{copy[1]}</p><p class="ema-contact-small">{c.contactSmall}</p><a class="ema-text-link" href={navRoutes[locale].home}>{copy[2]}<span aria-hidden="true">↗</span></a></section>
