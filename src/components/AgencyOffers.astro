---
import { getAgency, primaryServiceIndices, serviceRoutes } from '../data/agency';
import { getLocaleFromPath } from '../i18n';
import AuditForm from './AuditForm.astro';
const locale = getLocaleFromPath(Astro.url.pathname);
const c = getAgency(locale);
const paths = serviceRoutes[locale];
---
<section class="ema-page-hero ema-wrap">
  <p class="ema-eyebrow">EDDIE MILLER AGENCY / {c.nav[3]}</p>
  <h1>{c.offerTitle[0]}<br /><em>{c.offerTitle[1]}</em></h1>
  <p class="ema-prose">{c.description} {c.choice}</p>
</section>
<section class="ema-wrap" aria-label={c.nav[3]}>
  <div class="ema-offers">
    {primaryServiceIndices.map(i => <article class="ema-offer">
      <p class="ema-eyebrow">{c.pillars[i]}</p><h2>{c.services[i]}</h2>
      <div class="ema-price"><span>{c.priceLabel}</span><p>{c.prices[i]}</p><span>{c.priceNote}</span></div>
      <ul>{c.offerLists[i].map(line => <li>{line}</li>)}</ul>
      <a class="ema-text-link" href={`${paths[i]}#diagnostic`}>{c.contactLinks[i]} <span aria-hidden="true">↗</span></a>
    </article>)}
  </div>
  <p class="ema-ancillary"><a class="ema-text-link" href={paths[2]}>{c.webLink} <span aria-hidden="true">↗</span></a></p>
</section>
<section class="ema-wrap ema-follow"><div><p class="ema-eyebrow">EMA / {c.followLabel}</p><h2>{c.follow}</h2><p class="ema-prose">{c.followText}</p></div><div><p class="ema-follow-price">{c.followPrice}</p><p class="ema-offer-note">{c.followNote}</p></div></section>
<AuditForm />
