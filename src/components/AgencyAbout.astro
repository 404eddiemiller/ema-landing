---
import { getAgency } from '../data/agency';
import { getLocaleFromPath, t } from '../i18n';
import AuditForm from './AuditForm.astro';
const locale = getLocaleFromPath(Astro.url.pathname);
const c = getAgency(locale);
---
<section class="ema-page-hero ema-wrap"><p class="ema-eyebrow">EDDIE MILLER AGENCY / {t('header.about', locale)}</p><h1>{c.aboutTitle[0]}<br /><em>{c.aboutTitle[1]}</em></h1></section>
<section class="ema-wrap ema-about"><div class="ema-founder-mark" aria-hidden="true">em.<span>PARIS</span></div><div><p class="ema-prose">{c.aboutText}</p><p class="ema-prose">{c.aboutSecond}</p><p class="ema-founder-name">Eddie Miller Agency <span>— Paris</span></p></div></section>
<section class="ema-sand ema-section"><div class="ema-wrap"><p class="ema-eyebrow">{c.nav[2]}</p><h2>{c.methodTitle[0]}<br /><em>{c.methodTitle[1]}</em></h2><div class="ema-steps">{c.steps.map((step, i) => <article><span class="ema-step-number">0{i + 1}</span><h3>{step[0]}</h3><p>{step[1]}</p></article>)}</div></div></section>
<AuditForm />
