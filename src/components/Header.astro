---
import { locales, localeNames, getLocaleFromPath, navRoutes, getAlternateUrls, t } from '../i18n';
import { getAgency } from '../data/agency';
const locale = getLocaleFromPath(Astro.url.pathname);
const nav = navRoutes[locale];
const c = getAgency(locale);
const alternates = getAlternateUrls(Astro.url.pathname);
const links = [
  { label: c.nav[0], href: `${nav.home}#expertises` },
  { label: c.nav[1], href: `${nav.home}#metiers` },
  { label: c.nav[2], href: `${nav.home}#methode` },
  { label: c.nav[3], href: nav.pricing },
];
---
<header class="ema-header">
  <a href="#main-content" class="ema-skip">{t('header.skipToContent', locale)}</a>
  <div class="ema-wrap ema-header-inner">
    <a href={nav.home} class="ema-wordmark" aria-label={t('header.homeLabel', locale)}>eddie miller<span>AGENCY · PARIS</span></a>
    <nav class="ema-desktop-nav" aria-label={t('header.navLabel', locale)}>{links.map(link => <a href={link.href}>{link.label}</a>)}</nav>
    <div class="ema-header-actions">
      <button id="theme-toggle" class="ema-icon-button" type="button" aria-label={t('header.themeLabel', locale)} aria-pressed="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4v16M12 4a8 8 0 0 0 0 16" fill="currentColor"/></svg></button>
      <details class="ema-language"><summary aria-label={t('header.language', locale)}>{locale.toUpperCase()} <span aria-hidden="true">⌄</span></summary><div>{locales.map(l => <a href={alternates?.[l] ?? (l === 'fr' ? '/' : `/${l}/`)} lang={l} aria-current={l === locale ? 'true' : undefined}>{localeNames[l]}</a>)}</div></details>
      <a class="ema-header-contact" href={nav.audit}>{c.cta} <span aria-hidden="true">↗</span></a>
      <details class="ema-mobile-menu"><summary aria-label={t('header.menuLabel', locale)}><svg width="23" height="23" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h18M3 16h18"/></svg></summary><nav aria-label={t('header.navLabel', locale)}>{links.map(link => <a href={link.href}>{link.label}<span aria-hidden="true">↗</span></a>)}<a href={nav.about}>{t('header.about', locale)}<span aria-hidden="true">↗</span></a><a href={nav.audit}>{c.cta}<span aria-hidden="true">↗</span></a></nav></details>
    </div>
  </div>
</header>
<script>
  const themeButton = document.getElementById('theme-toggle');
  const currentDark = () => document.documentElement.dataset.theme ? document.documentElement.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  themeButton?.setAttribute('aria-pressed', String(currentDark()));
  themeButton?.addEventListener('click', () => {
    const next = currentDark() ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    themeButton.setAttribute('aria-pressed', String(next === 'dark'));
    try { localStorage.setItem('theme', next); } catch { /* Storage is optional. */ }
  });
  document.querySelectorAll<HTMLDetailsElement>('.ema-header details').forEach(menu => {
    menu.addEventListener('keydown', e => { if (e.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); } });
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { menu.open = false; }));
    menu.addEventListener('toggle', () => { if (menu.open) document.querySelectorAll<HTMLDetailsElement>('.ema-header details').forEach(other => { if (other !== menu) other.open = false; }); });
    document.addEventListener('click', e => { if (!menu.contains(e.target as Node)) menu.open = false; });
  });
</script>
