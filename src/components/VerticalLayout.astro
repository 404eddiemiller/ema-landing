---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { sectorCards, type Sector } from '../data/verticals';
import { getLocaleFromPath, pageRoutes, t } from '../i18n';

interface Props { sector: Sector }
const { sector } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const card = `verticals.card${sectorCards[sector]}`;
const name = t(`${card}Title`, locale);
const question = t(`${card}Question`, locale);
const facts = t(`${card}Text`, locale);
const visibility = t('vertical.visibility', locale);
const offer = pageRoutes.aiVisibility[locale];
const visitor = sector === 'restaurants' || sector === 'hotels' || sector === 'bars';
---
<Layout title={`${name} — ${visibility} | Eddie Miller Agency`} description={`${visibility} · ${name}. ${facts}`} skipFaqSchema>
  <Header />
  <main id="main-content">
    <section class="ema-page-hero ema-wrap">
      <p class="ema-eyebrow">PARIS / {name}</p>
      <h1>{name}<br /><em>{visibility}</em></h1>
      <p class="ema-prose">{t('solution.subtitle', locale)}</p>
      <a class="ema-button" href={offer}>{t('vertical.visibilityLink', locale)}<span aria-hidden="true">↗</span></a>
    </section>
    <section class="ema-sand ema-section">
      <div class="ema-wrap ema-two-col">
        <div>
          <p class="ema-eyebrow">{t(visitor ? 'vertical.visitorExample' : 'vertical.searchExample', locale)}</p>
          <h2>{question}</h2>
        </div>
        <div>
          <h3>{t('vertical.publicInfo', locale)}</h3>
          <p class="ema-prose">{facts}</p>
          <p class="ema-prose">{t('solution.aiBullet1', locale)}</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
