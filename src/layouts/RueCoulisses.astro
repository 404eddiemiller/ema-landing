---
import '../styles/rue-coulisses.css';
import { getAlternateUrls, locales, localeISO } from '../i18n';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const siteUrl = 'https://eddiemiller.agency';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = new URL(pathname, siteUrl).href;
const locale = 'fr';
const alternates = pathname === '/' ? getAlternateUrls('/') : null;
const languages = [['en','English'],['es','Español'],['de','Deutsch'],['it','Italiano'],['pt','Português'],['nl','Nederlands']];
const contacts = {
  geo: {title:'Que trouvent vos futurs clients ?', intro:'Indiquez votre adresse à Paris, votre site et une question que vos clients posent souvent.', button:'Parler de ma visibilité', form:'/visibilite-ia#diagnostic', subject:'Visibilité de mon établissement à Paris'},
  equipe: {title:'Quelle tâche prend trop de temps ?', intro:'Décrivez une tâche qui revient chaque semaine, les personnes qui s’en occupent et les outils déjà en place.', button:'Parler du travail de mon équipe', form:'/automatisation-ia#diagnostic', subject:'Conseil IA pour mon équipe à Paris'},
  accueil: {title:'Parlons de votre établissement.', intro:'Indiquez votre quartier et ce qui vous amène : être trouvé par vos futurs clients ou simplifier le travail de votre équipe.', button:'Écrire à l’agence', form:null, subject:'Premier échange pour mon établissement à Paris'}
};
const contact = pathname === '/diagnostic-geo' ? contacts.geo : pathname === '/conseil-ia' ? contacts.equipe : contacts.accueil;
const live = import.meta.env.PUBLIC_SITE_MODE === 'live';
const isPreview = !live;
const ogTitle=title, ogDescription=description, ogType='website', ogImage=siteUrl+'/social-card.png';
---
<!doctype html>
<html lang="fr"><head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f4eb" />

    <meta name="google-site-verification" content="40e5qXx2eUyxAmLgBGHqS-pSbohrWFWtwIgj2nrnkH0" />
    {(isPreview) && <meta name="robots" content="noindex, nofollow" />}


    <!-- Preconnect for external services -->
    {!isPreview && <link rel="preconnect" href="https://plausible.io" crossorigin />}
    {!isPreview && <link rel="dns-prefetch" href="https://plausible.io" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Hreflang alternate links for SEO -->
    {alternates && locales.map((l) => (
      <link rel="alternate" hreflang={l} href={`${siteUrl}${alternates[l]}`} />
    ))}
    {alternates && (
      <link rel="alternate" hreflang="x-default" href={`${siteUrl}${alternates.fr}`} />
    )}

    <!-- Preload fonts -->
    <link rel="preload" href="/fonts/DMSerifDisplay-Regular.woff2" as="font" type="font/woff2" crossorigin fetchpriority="high" />
    <link rel="preload" href="/fonts/DMSans-Variable.woff2" as="font" type="font/woff2" crossorigin fetchpriority="high" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={localeISO[locale]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Eddie Miller Agency" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:description" content={ogDescription} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "ProfessionalService",
      name: 'Eddie Miller Agency', url: siteUrl, description: description,
      email: 'contact@eddiemiller.agency', areaServed: { "@type": "City", name: 'Paris' },
      serviceType: ['Visibilité sur ChatGPT, Claude et Gemini à Paris', 'Conseil IA et automatisations pour les équipes parisiennes']
    })} />
    <!-- WebSite schema — tells Google to show "Eddie Miller Agency" as site name -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Eddie Miller Agency",
        "url": "https://eddiemiller.agency"
      }
    </script>

    <!-- Plausible Analytics -->
    {!isPreview && <script is:inline async src="https://plausible.io/js/pa-V0XLRxsUEbXHqAAPrygvE.js"></script>}
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

</head><body>

<a class="skip" href="#contenu">Aller au contenu</a><header class="mast"><div class="wrap mastinner"><a class="brand" href="/" aria-label="Eddie Miller Agency, accueil">eddie miller<span>.</span><small>Agency</small></a><nav aria-label="Navigation principale"><a class="navlink" aria-current={pathname === "/diagnostic-geo" ? "page" : undefined} href="/diagnostic-geo">Visibilité locale</a><a class="navlink" aria-current={pathname === "/conseil-ia" ? "page" : undefined} href="/conseil-ia">Conseil IA</a><a class="cta small" href="#contact">Premier échange <span aria-hidden="true">↗</span></a></nav></div></header>
<main id="contenu" tabindex="-1"><slot /></main>

<footer id="contact"><div class="wrap"><div class="contactgrid" id="diagnostic"><div><p class="rub">Le premier échange</p><h2>{contact.title}</h2><p>{contact.intro}</p></div><div><a class="cta" href={live ? `mailto:contact@eddiemiller.agency?subject=${encodeURIComponent(contact.subject)}` : undefined}>{live ? contact.button : "Contact désactivé en aperçu"} <span aria-hidden="true">↗</span></a><small>15 minutes pour en parler, sans engagement.</small>{contact.form && <a class="formlink" href={contact.form}>Préparer ma demande avec le formulaire</a>}</div></div><details class="annuaire" id="metiers"><summary>La visibilité à Paris, métier par métier</summary><div class="liens">
<a href="/restaurants">Restaurants</a><a href="/bars">Bars</a><a href="/hotels">Hôtels</a><a href="/coiffure">Coiffeurs</a><a href="/spa">Spas</a><a href="/sport">Salles de sport</a><a href="/medical">Cabinets médicaux</a><a href="/dentistes">Dentistes</a><a href="/avocats">Avocats</a></div></details>
<nav class="langues" aria-label="Autres langues">{languages.map(([lang, name]) => <a href={'/'+lang+'/'} lang={lang} hreflang={lang}>{name}</a>)}</nav><div class="bas"><a class="brand" href="/" aria-label="Eddie Miller Agency, retour à l’accueil">eddie miller<span>.</span></a><div><a href="/formules">Formules</a><a href="/a-propos">À propos</a><a href="/blog">Journal</a><a href="/mentions-legales">Mentions légales</a><a href="/cgv">CGV</a></div></div></div></footer>
</body></html>
